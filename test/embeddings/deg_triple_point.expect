# Edges 0, 2 and 4 lie on the three lines y=0, x=0 and y=x, so all three
# project through the origin. Their heights there are 0, 1 and 2, so the
# triple point is resolvable but only by the perturbation.
note = three pairwise non-adjacent segments concurrent at one projected point
knot = unknot
multiple_points      == 1
max_point_multiplicity == 3
transversal          >= 3
spatial              == 0
