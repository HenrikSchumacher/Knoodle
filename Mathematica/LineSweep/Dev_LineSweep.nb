       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"x1", ",", "x2"}], "}"}], "=", 
        RowBox[{"segments", "[", 
         RowBox[{"[", 
          RowBox[{"i", ",", "All", ",", "1"}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"y", "=", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"x1", "==", "x"}], ",", 
          RowBox[{"segments", "[", 
           RowBox[{"[", 
            RowBox[{"i", ",", "1", ",", "2"}], "]"}], "]"}], ",", 
          RowBox[{"segments", "[", 
