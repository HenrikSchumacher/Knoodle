    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"m", ",", "k"}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"print", "[", 
        RowBox[{"\"\<---findByCoordinate[\>\"", ",", "x", ",", "\"\<,\>\"", ",",
          "y", ",", "\"\<,\>\"", ",", "slope", ",", "\"\<]---\>\""}], "]"}], ";",
        "\[IndentingNewLine]", 
       RowBox[{"m", "=", 
        RowBox[{"Length", "[", "activeSegments", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"TODO", ":", " ", 
         RowBox[{"Use", " ", "binary", " ", 
          RowBox[{"search", ".", " ", "Or"}], " ", "use", " ", "some", " ", 
          "clever", " ", "data", " ", "structure", " ", "for", " ", 
          RowBox[{"activeSegments", "."}]}]}], "*)"}], "\[IndentingNewLine]", 
       
       RowBox[{"k", "=", "1"}], ";", "\[IndentingNewLine]", 
       RowBox[{"While", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"k", "<=", "m"}], ")"}], "&&", 
          RowBox[{"(", 
           RowBox[{"y", ">", 
            RowBox[{"gety", "[", 
             RowBox[{"x", ",", 
              RowBox[{"activeSegments", "[", 
               RowBox[{"[", "k", "]"}], "]"}]}], "]"}]}], ")"}]}], ",", 
         RowBox[{"++", "k"}]}], "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"While", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"k", "<=", "m"}], ")"}], "&&", 
          RowBox[{"(", 
           RowBox[{"y", "==", 
            RowBox[{"gety", "[", 
             RowBox[{"x", ",", 
              RowBox[{"activeSegments", "[", 
               RowBox[{"[", "k", "]"}], "]"}]}], "]"}]}], ")"}], "&&", 
          RowBox[{"(", 
           RowBox[{"slope", ">", 
            RowBox[{"segmentdata", "[", 
             RowBox[{"[", 
              RowBox[{
               RowBox[{"activeSegments", "[", 
                RowBox[{"[", "k", "]"}], "]"}], ",", "2"}], "]"}], "]"}]}], 
           ")"}]}], ",", 
         RowBox[{"++", "k"}]}], "]"}], ";", "\[IndentingNewLine]", "k"}]}], 
     "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ClearAll", "[", "findByIndex", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
