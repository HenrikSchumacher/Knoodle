          RowBox[{"[", "i", "]"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"print", "[", 
        RowBox[{"\"\<x1\>\"", "->", "x1"}], "]"}], ";", "\[IndentingNewLine]", 
