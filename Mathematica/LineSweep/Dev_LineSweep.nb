 RowBox[{
  RowBox[{"ClearAll", "[", "checkIntersection", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"checkIntersection", "[", 
     RowBox[{"x_", ",", "i0_", ",", "j0_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "x0", ",", "y0", ",", "R", ",", "ptr", ",", "i", ",", "j", ",", "si", ",",
         "sj"}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"print", "[", 
        RowBox[{"\"\<checkIntersection[\>\"", ",", "x", ",", "\"\<,\>\"", ",",
          "i0", ",", "\"\<,\>\"", ",", "j0", ",", "\"\<]\>\""}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"i0", "<=", "j0"}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"i", "=", "i0"}], ";", 
          RowBox[{"j", "=", "j0"}], ";"}], "\[IndentingNewLine]", ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"i", "=", "j0"}], ";", 
          RowBox[{"j", "=", "i0"}], ";"}]}], "\[IndentingNewLine]", "]"}], ";",
        "\[IndentingNewLine]", 
       RowBox[{"si", "=", 
        RowBox[{"segments", "[", 
         RowBox[{"[", "i", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"sj", "=", 
        RowBox[{"segments", "[", 
         RowBox[{"[", "j", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"!", 
          RowBox[{"KeyExistsQ", "[", 
           RowBox[{"intersections", ",", 
            RowBox[{"{", 
             RowBox[{"i", ",", "j"}], "}"}]}], "]"}]}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"R", "=", 
           RowBox[{"RegionIntersection", "[", 
            RowBox[{
             RowBox[{"Line", "[", "si", "]"}], ",", 
             RowBox[{"Line", "[", "sj", "]"}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"print", "[", 
           RowBox[{"\"\<R\>\"", "->", "R"}], "]"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"R", "=!=", 
             RowBox[{"EmptyRegion", "[", "2", "]"}]}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{"(", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"While", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"Head", "[", "R", "]"}], "=!=", "Point"}], ",", 
                RowBox[{"R", "=", 
                 RowBox[{"R", "[", 
                  RowBox[{"[", "1", "]"}], "]"}]}]}], "]"}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"x0", "=", 
               RowBox[{"R", "[", 
                RowBox[{"[", 
                 RowBox[{"1", ",", "1"}], "]"}], "]"}]}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"y0", "=", 
               RowBox[{"R", "[", 
                RowBox[{"[", 
                 RowBox[{"1", ",", "2"}], "]"}], "]"}]}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"print", "[", 
               RowBox[{"\"\<Found intersection \>\"", ",", 
                RowBox[{"{", 
                 RowBox[{"i", ",", "j"}], "}"}], ",", "\"\<.\>\""}], "]"}], ";",
               "\[IndentingNewLine]", 
              RowBox[{"print", "[", 
               RowBox[{"\"\<x\>\"", "->", "x"}], "]"}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"print", "[", 
               RowBox[{"\"\<x0\>\"", "->", "x0"}], "]"}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"print", "[", 
               RowBox[{"\"\<x0>=x\>\"", "->", 
                RowBox[{"(", 
                 RowBox[{"x0", ">=", "x"}], ")"}]}], "]"}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{"x0", ">=", "x"}], ",", "\[IndentingNewLine]", 
                RowBox[{"(", "\[IndentingNewLine]", 
                 RowBox[{
                  RowBox[{"AssociateTo", "[", 
                   RowBox[{"intersections", ",", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{"i", ",", "j"}], "}"}], "->", 
                    RowBox[{"R", "[", 
                    RowBox[{"[", "1", "]"}], "]"}]}]}], "]"}], ";", 
                  "\[IndentingNewLine]", 
                  RowBox[{"(*", 
                   RowBox[{
                    RowBox[{
                    "If", " ", "the", " ", "intersection", " ", "is", " ", 
                    "a", " ", "death", " ", "or", " ", "birth", " ", "event", 
                    " ", "for", " ", "a", " ", "i", " ", "or", " ", "j"}], ",",
                     " ", 
                    RowBox[{
                    "then", " ", "mark", " ", "it", " ", "with", " ", 
                    "dbIntersectionPriority", " ", "so", " ", "that", " ", 
                    "swapping", " ", "is", " ", "skipped", " ", 
                    RowBox[{"downstream", "."}]}]}], "*)"}], 
                  "\[IndentingNewLine]", 
                  RowBox[{"If", "[", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{"x0", ",", "y0"}], "}"}], "==", 
                    RowBox[{"si", "[", 
                    RowBox[{"[", "1", "]"}], "]"}]}], ")"}], "||", 
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{"x0", ",", "y0"}], "}"}], "==", 
                    RowBox[{"si", "[", 
                    RowBox[{"[", "2", "]"}], "]"}]}], ")"}], "||", 
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{"x0", ",", "y0"}], "}"}], "==", 
                    RowBox[{"sj", "[", 
                    RowBox[{"[", "1", "]"}], "]"}]}], ")"}], "||", 
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{"x0", ",", "y0"}], "}"}], "==", 
                    RowBox[{"sj", "[", 
                    RowBox[{"[", "2", "]"}], "]"}]}], ")"}]}], ",", 
                    "\[IndentingNewLine]", 
                    RowBox[{
                    RowBox[{"print", "[", 
                    RowBox[{"\"\<Queued \>\"", ",", 
                    RowBox[{"{", 
                    RowBox[{"i", ",", "j"}], "}"}], 
                    ",", "\"\< with  dbIntersectionPriority.\>\""}], "]"}], ";",
                     "\[IndentingNewLine]", 
                    RowBox[{"queue", "[", 
                    RowBox[{"\"\<Push\>\"", ",", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"-", "x0"}], ",", "dbIntersectionPriority", ",", 
                    "i", ",", "j"}], "}"}]}], "]"}], ";"}], 
                    "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
                    RowBox[{
                    RowBox[{"print", "[", 
                    RowBox[{"\"\<Queued \>\"", ",", 
                    RowBox[{"{", 
                    RowBox[{"i", ",", "j"}], "}"}], 
                    ",", "\"\< with  IntersectionPriority.\>\""}], "]"}], ";",
                     "\[IndentingNewLine]", 
                    RowBox[{"queue", "[", 
                    RowBox[{"\"\<Push\>\"", ",", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"-", "x0"}], ",", "intersectionPriority", ",", 
                    "i", ",", "j"}], "}"}]}], "]"}], ";"}]}], 
                   "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", 
                 ")"}], "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
                RowBox[{
                 RowBox[{
                 "print", "[", "\"\<No new intersection found.\>\"", "]"}], 
                 ";"}]}], "\[IndentingNewLine]", "]"}]}], 
             "\[IndentingNewLine]", ")"}], ",", "\[IndentingNewLine]", 
            RowBox[{
            "print", "[", "\"\<Line segments do not intersect.\>\"", "]"}]}], 
           "\[IndentingNewLine]", "]"}], ";"}]}], "\[IndentingNewLine]", 
        "]"}], ";"}]}], "\[IndentingNewLine]", "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ClearAll", "[", "birth", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"birth", "[", 
     RowBox[{"x_", ",", "i_Integer"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
