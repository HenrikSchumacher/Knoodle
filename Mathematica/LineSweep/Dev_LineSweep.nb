 RowBox[{
  RowBox[{"ClearAll", "[", "findByCoordinate", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"findByCoordinate", "[", 
