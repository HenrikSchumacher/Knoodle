Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"LeftSubtree", "[", 
     RowBox[{"T_RBTree", ",", "node_Integer"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", "L", "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"L", "=", 
        RowBox[{"T", "@", 
         RowBox[{"\"\<LeftChild\>\"", "[", "node", "]"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"L", "==", 
          RowBox[{"T", "@", 
           RowBox[{"\"\<Nil\>\"", "[", "]"}]}]}], ",", "\[IndentingNewLine]", 
         
         RowBox[{"Style", "[", 
          RowBox[{"\"\<NIL\>\"", ",", 
           RowBox[{"{", 
            RowBox[{"Black", ",", "Bold"}], "}"}]}], "]"}], 
         "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
         RowBox[{"Tree", "[", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"Style", "[", 
            RowBox[{
             RowBox[{"L", "->", 
              RowBox[{"Style", "[", 
               RowBox[{
                RowBox[{"T", "@", 
                 RowBox[{"\"\<Data\>\"", "[", "L", "]"}]}], ",", "Bold"}], 
               "]"}]}], ",", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"T", "@", 
                 RowBox[{"\"\<State\>\"", "[", "L", "]"}]}], "==", "2"}], ",",
