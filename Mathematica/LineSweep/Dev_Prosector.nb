Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
      "U", " ", "and", " ", "V", " ", "are", " ", "supposed", " ", "to", " ", 
       "be", " ", "3", "D", " ", 
       RowBox[{"vectors", ".", " ", "The"}], " ", "third", " ", "coordinate", 
       " ", "is", " ", "used", " ", "for", " ", "breaking", " ", 
       RowBox[{"ties", ":", "\[IndentingNewLine]", 
        RowBox[{
        "What", " ", "is", " ", "computed", " ", "is", " ", "the", " ", 
         "sign", " ", "of", " ", "the", " ", "determinant", " ", "of", " ", "\[IndentingNewLine]", 
         RowBox[{"Det", "[", 
          RowBox[{"{", " ", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"{", " ", 
             RowBox[{
              RowBox[{
               RowBox[{"U", "[", 
                RowBox[{"[", "1", "]"}], "]"}], " ", "-", " ", 
               RowBox[{"\[Epsilon]", " ", 
                RowBox[{"U", "[", 
                 RowBox[{"[", "3", "]"}], "]"}]}]}], ",", " ", 
              RowBox[{
               RowBox[{"U", "[", 
                RowBox[{"[", "2", "]"}], "]"}], " ", "-", " ", 
               RowBox[{
                RowBox[{"\[Epsilon]", "^", "2"}], " ", 
                RowBox[{"U", "[", 
                 RowBox[{"[", "3", "]"}], "]"}]}]}]}], "}"}], ",", " ", 
            "\[IndentingNewLine]", 
            RowBox[{"{", " ", 
             RowBox[{
              RowBox[{
               RowBox[{"V", "[", 
                RowBox[{"[", "1", "]"}], "]"}], " ", "-", " ", 
               RowBox[{"\[Epsilon]", " ", 
                RowBox[{"V", "[", 
                 RowBox[{"[", "3", "]"}], "]"}]}]}], ",", " ", 
              RowBox[{
               RowBox[{"V", "[", 
                RowBox[{"[", "2", "]"}], "]"}], " ", "-", " ", 
               RowBox[{
                RowBox[{"\[Epsilon]", "^", "2"}], " ", 
                RowBox[{"V", "[", 
                 RowBox[{"[", "3", "]"}], "]"}]}]}]}], "\[IndentingNewLine]", 
             "}"}]}]}]}]}]}]}], "]"}], "\[IndentingNewLine]", "for", " ", 
     "\[Epsilon]", " ", "go", " ", "to", " ", "0", " ", "from", " ", "the", " ", 
     RowBox[{"right", ".", " ", "This"}], " ", "corresponds", " ", "to", " ", 
     "projecting", " ", "parallel", " ", "to", " ", "the", " ", "x"}], "-", 
    "y", "-", 
    RowBox[{"plane", " ", "along", " ", "the", " ", "vector", " ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\[Epsilon]", ",", " ", 
        RowBox[{"\[Epsilon]", "^", "2"}], ",", " ", "1"}], "}"}], "."}]}]}], 
   "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"cSignDet", "=", 
     RowBox[{"Compile", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"U", ",", "_Real", ",", "1"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"V", ",", "_Real", ",", "1"}], "}"}]}], "}"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"a", ",", "b"}], "}"}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"a", "=", 
           RowBox[{
            RowBox[{"Compile`GetElement", "[", 
             RowBox[{"U", ",", "1"}], "]"}], " ", 
            RowBox[{"Compile`GetElement", "[", 
             RowBox[{"V", ",", "2"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"b", "=", 
           RowBox[{
            RowBox[{"Compile`GetElement", "[", 
             RowBox[{"U", ",", "2"}], "]"}], " ", 
            RowBox[{"Compile`GetElement", "[", 
             RowBox[{"V", ",", "1"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"a", ">", "b"}], ",", 
            RowBox[{"Return", "[", "1", "]"}]}], "]"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"a", "<", "b"}], ",", 
            RowBox[{"Return", "[", 
             RowBox[{"-", "1"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
          "\[IndentingNewLine]", 
          RowBox[{"a", "=", 
           RowBox[{
            RowBox[{"Compile`GetElement", "[", 
             RowBox[{"U", ",", "2"}], "]"}], " ", 
            RowBox[{"Compile`GetElement", "[", 
             RowBox[{"V", ",", "3"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"b", "=", 
           RowBox[{
            RowBox[{"Compile`GetElement", "[", 
             RowBox[{"U", ",", "3"}], "]"}], " ", 
            RowBox[{"Compile`GetElement", "[", 
             RowBox[{"V", ",", "2"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"a", ">", "b"}], ",", 
            RowBox[{"Return", "[", "1", "]"}]}], "]"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"a", "<", "b"}], ",", 
            RowBox[{"Return", "[", 
             RowBox[{"-", "1"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
          "\[IndentingNewLine]", 
          RowBox[{"a", "=", 
           RowBox[{
            RowBox[{"Compile`GetElement", "[", 
             RowBox[{"U", ",", "3"}], "]"}], " ", 
            RowBox[{"Compile`GetElement", "[", 
             RowBox[{"V", ",", "1"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"b", "=", 
           RowBox[{
            RowBox[{"Compile`GetElement", "[", 
             RowBox[{"U", ",", "1"}], "]"}], " ", 
            RowBox[{"Compile`GetElement", "[", 
             RowBox[{"V", ",", "3"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"a", ">", "b"}], ",", 
            RowBox[{"Return", "[", "1", "]"}]}], "]"}], ";", 
          "\[IndentingNewLine]", 
