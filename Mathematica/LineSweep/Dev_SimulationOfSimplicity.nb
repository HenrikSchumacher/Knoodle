Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "detSign", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"detSign", "[", 
   RowBox[{"u_", ",", "v_", ",", "\[Epsilon]_"}], "]"}], ":=", 
  RowBox[{"Block", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"det", ",", "det0"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"det", "=", 
      RowBox[{"Det", "[", 
       RowBox[{"{", 
        RowBox[{"u", ",", "v"}], "}"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"det0", "=", 
      RowBox[{"det", "/.", 
       RowBox[{"\[Epsilon]", "->", "0"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"det0", "!=", "0"}], ",", "\[IndentingNewLine]", 
       RowBox[{"Sign", "[", "det0", "]"}], "\[IndentingNewLine]", ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"rules", "=", 
         RowBox[{"KeyValueMap", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"{", 
             RowBox[{"key", ",", "value"}], "}"}], "\[Function]", 
            RowBox[{
             RowBox[{"key", "[", 
              RowBox[{"[", "1", "]"}], "]"}], "->", "value"}]}], ",", 
           RowBox[{"Association", "@", 
            RowBox[{"CoefficientRules", "[", 
             RowBox[{"det", ",", "\[Epsilon]"}], "]"}]}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Sign", "[", 
         RowBox[{
          RowBox[{"Min", "[", 
           RowBox[{"Keys", "[", "rules", "]"}], "]"}], "/.", "rules"}], 
         "]"}]}]}], "\[IndentingNewLine]", "]"}]}]}], "\[IndentingNewLine]", 
   "]"}]}], "\[IndentingNewLine]"}], "Input",
