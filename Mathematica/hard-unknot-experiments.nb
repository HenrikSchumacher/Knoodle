               RowBox[{"[", 
                RowBox[{"3", ";;"}], "]"}], "]"}]}]}], "\[IndentingNewLine]", 
            "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", "0", ",", 
             RowBox[{
              RowBox[{"Length", "[", "L", "]"}], "-", "1"}]}], "}"}]}], " ", 
          "\[IndentingNewLine]", "]"}], ",", "1"}], "]"}]}]}]}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
