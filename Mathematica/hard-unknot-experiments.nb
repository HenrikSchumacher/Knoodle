Cell["\<\
Nice! Ok, now we\[CloseCurlyQuote]re going to sew this together into a \
function that I can iterate:\
\>", "Text",
 CellChangeTimes->{{3.938330486798009*^9, 
  3.938330505443012*^9}},ExpressionUUID->"209c9571-1263-44e8-9d39-\
e9258d6faa6a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ClearAll", "[", "LevelsSimplify", "]"}], ";", 
  RowBox[{
   RowBox[{"LevelsSimplify", "[", "PD_", "]"}], ":=", " ", 
   RowBox[{"Block", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "Lf", ",", "R", ",", "NewPD", ",", "SimplifiedNewPD", ",", "Dlf"}], 
      "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"CompressDiagramInPlace", "[", "PD", "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Lf", " ", "=", " ", 
       RowBox[{"QuadraticOptimization", "[", 
        RowBox[{
         RowBox[{"BuildObjectiveFunction", "[", 
          RowBox[{"PDCode", "@", "PD"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"BuildConstraintMatrix", "[", 
            RowBox[{"PDCode", "@", "PD"}], "]"}], ",", 
           RowBox[{"ConstantArray", "[", 
            RowBox[{
             RowBox[{"-", "2"}], ",", 
             RowBox[{"Length", "[", 
              RowBox[{"PDCode", "@", "PD"}], "]"}]}], "]"}]}], "}"}]}], 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Dlf", " ", "=", " ", 
       RowBox[{"2", "*", 
        RowBox[{"Flatten", "[", 
         RowBox[{
          RowBox[{"Values", "@", " ", 
           RowBox[{"KeySort", "@", 
            RowBox[{"PositionIndex", "[", 
             RowBox[{
              RowBox[{"Sort", "[", 
               RowBox[{"MapIndexed", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"{", 
                   RowBox[{"#1", ",", 
                    RowBox[{"#2", "[", 
                    RowBox[{"[", "1", "]"}], "]"}]}], "}"}], "&"}], ",", 
                 "Lf"}], "]"}], "]"}], "[", 
              RowBox[{"[", 
               RowBox[{"All", ",", "2"}], "]"}], "]"}], "]"}]}]}], ",", "1"}],
          "]"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"R", " ", "=", " ", 
       RowBox[{"RandomVariate", "[", 
        RowBox[{"CircularRealMatrixDistribution", "[", "3", "]"}], "]"}]}], 
      ";", "\[IndentingNewLine]", 
      RowBox[{"NewPD", " ", "=", " ", 
       RowBox[{"PlanarDiagram", "[", 
        RowBox[{
         RowBox[{"LevelsEmbedding", "[", 
          RowBox[{"PD", ",", 
           RowBox[{"150", "*", "Lf"}]}], "]"}], ".", "R"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"CompressDiagramInPlace", "[", "NewPD", "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"SimplifyDiagram4", "[", "NewPD", "]"}]}]}], 
    "\[IndentingNewLine]", "]"}]}]}]], "Input",
 CellChangeTimes->{{3.938330508579831*^9, 3.938330559454308*^9}, {
   3.9383305965582123`*^9, 3.938330692322103*^9}, {3.9383307674744*^9, 
