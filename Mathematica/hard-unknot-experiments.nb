Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "RepeatedLevelsSimplify", "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"RepeatedLevelsSimplify", "[", "PD_", "]"}], ":=", " ", 
  RowBox[{"Block", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"trials", "=", "0"}], ",", "PDS"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"PDS", "=", 
      RowBox[{"NestWhile", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"trials", "++"}], ";", 
           RowBox[{"LevelsSimplify", "[", "#", "]"}]}], ")"}], "&"}], ",", 
        "PD", ",", 
        RowBox[{
         RowBox[{
          RowBox[{"CrossingCount", "[", "#", "]"}], ">", "0"}], "&"}], ",", 
        "1", ",", "10"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"CrossingCount", "[", "PDS", "]"}], ">", "0"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"\"\<Defeat after \>\"", "<>", 
          RowBox[{"ToString", "[", "trials", "]"}], "<>", "\"\< rounds\>\""}],
          ",", "PDS"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"\"\<Victory for Levels on Round \>\"", "<>", 
         RowBox[{"ToString", "[", "trials", "]"}]}], "}"}]}], "]"}]}]}], 
   "\[IndentingNewLine]", "]"}]}]}], "Input",
 CellChangeTimes->{{3.939127983612894*^9, 3.939128204601737*^9}, {
  3.939128411900955*^9, 3.939128442273102*^9}, {3.9391285352152777`*^9, 
