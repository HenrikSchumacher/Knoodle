Cell[BoxData[
 RowBox[{"PlotDiagram", "[", "PD", "]"}]], "Input",
 CellChangeTimes->{{3.938092435988318*^9, 3.938092441532565*^9}, {
  3.938092478797193*^9, 3.9380924832019053`*^9}, {3.9380925209789267`*^9, 
  3.938092522846479*^9}},
 CellLabel->"In[17]:=",ExpressionUUID->"432a1bae-fa8d-402f-9fbc-8983435d63eb"],

Cell["\<\
We\[CloseCurlyQuote]re going to assign a variable to each edge, giving the \
height of the edge as it leaves the crossing. We assume that edges stay at \
the same height through a crossing, so each arcline is going to need to \
access two heights; one as it leaves a crossing and the next arc in line\
\[CloseCurlyQuote]s height as it leaves the subsequent crossing. The \
quadratic objective function is just going to be the graph Laplacian of the \
cycle graph with 2n edges.  For each {a, b, c, d} in the PD code, we know \
that a is the incoming lower edge, c is the outgoing lower edge, and b and d \
are the overstrand, so we start by identifying these:\
\>", "Text",
 CellChangeTimes->{{3.9372415898611393`*^9, 3.937241657075429*^9}, {
  3.9372418203203287`*^9, 3.937241823989394*^9}, {3.938263255476048*^9, 
  3.938263397332266*^9}, {3.9382641660452423`*^9, 3.93826417889579*^9}, {
  3.938264242917954*^9, 
  3.938264247806714*^9}},ExpressionUUID->"aac17f83-ba3c-42a8-b3e6-\
4d5d2bc07358"],

Cell["\<\
Now we can set up a line in the constraint matrix so that when we dot it by \
vector of heights, the height associated with the overstrand is larger. We \
note that these matrix indices are offset by 1 from the edges they represent. \
\>", "Text",
 CellChangeTimes->{{3.93826418653122*^9, 3.938264229191448*^9}, {
  3.93826426471173*^9, 
  3.938264286490223*^9}},ExpressionUUID->"f641d858-264d-4652-8132-\
8c92651459c0"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"OutStrands", "[", 
    RowBox[{"{", 
     RowBox[{"a_", ",", "b_", ",", "c_", ",", "d_"}], "}"}], "]"}], ":=", " ", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"\"\<under\>\"", "->", "c"}], ",", 
     RowBox[{"\"\<over\>\"", "->", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"b", "-", "d"}], ")"}], "2"], "==", "1"}], ",", 
        RowBox[{"Max", "[", 
         RowBox[{"{", 
          RowBox[{"b", ",", "d"}], "}"}], "]"}], ",", 
        RowBox[{"Min", "[", 
         RowBox[{"{", 
          RowBox[{"b", ",", "d"}], "}"}], "]"}]}], "]"}]}]}], "|>"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"ConstraintLine", "[", 
    RowBox[{"x_", ",", "r_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"r", "[", 
           RowBox[{"[", "1", "]"}], "]"}], ",", 
          RowBox[{
           RowBox[{"#", "[", "\"\<under\>\"", "]"}], "+", "1"}]}], "}"}], "->", 
        RowBox[{"-", "1"}]}], ",", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"r", "[", 
           RowBox[{"[", "1", "]"}], "]"}], ",", 
          RowBox[{
           RowBox[{"#", "[", "\"\<over\>\"", "]"}], "+", "1"}]}], "}"}], "->", 
        RowBox[{"+", "1"}]}]}], "}"}], "&"}], "@", 
    RowBox[{"OutStrands", "[", 
     RowBox[{"x", "[", 
      RowBox[{"[", 
       RowBox[{"1", ";;", "4"}], "]"}], "]"}], "]"}]}]}], " ", 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"BuildConstraintMatrix", "[", "PD_", "]"}], " ", ":=", " ", 
   "\[IndentingNewLine]", 
   RowBox[{"SparseArray", "[", 
    RowBox[{
     RowBox[{"Flatten", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"MapIndexed", "[", "\[IndentingNewLine]", 
        RowBox[{"ConstraintLine", ",", "PD"}], "]"}], ",", 
       "\[IndentingNewLine]", "1"}], "]"}], ",", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Length", "[", "PD", "]"}], ",", 
       RowBox[{"2", 
        RowBox[{"Length", "[", "PD", "]"}]}]}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"BuildObjectiveFunction", "[", "PD_", "]"}], " ", ":=", 
   RowBox[{"SparseArray", "[", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"#", ".", "#"}], ")"}], "&"}], "@", 
       RowBox[{"KirchhoffMatrix", "[", 
        RowBox[{"CycleGraph", "[", 
         RowBox[{"2", "*", 
          RowBox[{"Length", "[", "PD", "]"}]}], "]"}], "]"}]}], ")"}], " ", 
     "+", " ", 
     RowBox[{"0.1", 
      RowBox[{"IdentityMatrix", "[", 
       RowBox[{"2", "*", 
        RowBox[{"Length", "[", "PD", "]"}]}], "]"}]}]}], "]"}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.938263707369814*^9, 3.9382638509951677`*^9}, {
  3.938263918962113*^9, 3.93826392911831*^9}, {3.938263964817236*^9, 
  3.938263971569763*^9}, {3.938264115795162*^9, 3.938264125824602*^9}, {
  3.938264252863598*^9, 3.9382642574998302`*^9}, {3.9391171674479628`*^9, 
  3.939117220577463*^9}},
 CellLabel->"In[18]:=",ExpressionUUID->"c80ea3c9-500c-401b-91e1-e8e04b938f18"],

Cell[BoxData[
 RowBox[{"Timing", "[", 
  RowBox[{
   RowBox[{"SuggestedLevels", " ", "=", " ", 
    RowBox[{"QuadraticOptimization", "[", 
     RowBox[{
      RowBox[{"BuildObjectiveFunction", "[", 
       RowBox[{"PDCode", "@", "PD"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"BuildConstraintMatrix", "[", 
         RowBox[{"PDCode", "@", "PD"}], "]"}], ",", 
        RowBox[{"ConstantArray", "[", 
         RowBox[{
          RowBox[{"-", "2"}], ",", 
          RowBox[{"Length", "[", 
           RowBox[{"PDCode", "@", "PD"}], "]"}]}], "]"}]}], "}"}]}], "]"}]}], 
   ";"}], "]"}]], "Input",
 CellChangeTimes->{{3.937242777228571*^9, 3.937242846151305*^9}, {
   3.9372428870318747`*^9, 3.937242898558545*^9}, {3.937243001447654*^9, 
   3.9372430247292128`*^9}, {3.9372432638833427`*^9, 3.937243333922037*^9}, {
   3.937243419985442*^9, 3.937243494262061*^9}, {3.937243894637019*^9, 
   3.937243897401422*^9}, {3.938093302227085*^9, 3.9380933183379517`*^9}, 
   3.9382643863510027`*^9, 3.938264427948367*^9},
 CellLabel->"In[22]:=",ExpressionUUID->"06e07ef2-9b47-4a8b-bfdb-35cf45de1328"],

Cell["\<\
We now check that we\[CloseCurlyQuote]ve correctly encoded the constraints by \
checking that at each crossing the difference between the outgoing arcs obeys \
the condition:\
\>", "Text",
 CellChangeTimes->{{3.938264542486005*^9, 
  3.938264584365284*^9}},ExpressionUUID->"368cf8f2-ac76-449e-bda0-\
2a88f32af4ee"],

Cell[BoxData[
 RowBox[{
  RowBox[{"LevelsFunctionOkQ", "[", 
   RowBox[{"PD_", ",", "f_"}], "]"}], ":=", " ", 
  RowBox[{"And", " ", "@@", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"f", "[", 
         RowBox[{"[", 
          RowBox[{
           RowBox[{"#", "[", "\"\<over\>\"", "]"}], "+", "1"}], "]"}], "]"}], 
        "-", 
        RowBox[{"f", "[", 
         RowBox[{"[", 
          RowBox[{
           RowBox[{"#", "[", "\"\<under\>\"", "]"}], "+", "1"}], "]"}], 
         "]"}]}], " ", ">=", " ", "2"}], " ", "&"}], " ", "/@", " ", 
     RowBox[{"(", 
      RowBox[{"OutStrands", " ", "/@", " ", 
       RowBox[{"PD", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", 
          RowBox[{"1", ";;", "4"}]}], "]"}], "]"}]}], ")"}]}], 
    ")"}]}]}]], "Input",
 CellChangeTimes->{{3.938264516030034*^9, 3.938264532628029*^9}, {
  3.9382645865562077`*^9, 3.9382647676581163`*^9}},
 CellLabel->"In[23]:=",ExpressionUUID->"1cbd998c-fb91-4ed3-bebc-a8839f142501"],

Cell[BoxData[
 RowBox[{"LevelsFunctionOkQ", "[", 
  RowBox[{
   RowBox[{"PDCode", "[", "PD", "]"}], ",", "SuggestedLevels"}], 
  "]"}]], "Input",
 CellChangeTimes->{{3.9382647409683332`*^9, 3.938264758955016*^9}},
 CellLabel->"In[24]:=",ExpressionUUID->"1e9b97fc-02d8-4a16-98fa-9d71e222271a"],

Cell["So far, so good. ", "Text",
 CellChangeTimes->{{3.9382647792619133`*^9, 
  3.938264781287838*^9}},ExpressionUUID->"e30427fc-4e7e-4373-8fdd-\
a706d2de5555"],

Cell[BoxData[
 RowBox[{"ListPlot", "[", "SuggestedLevels", "]"}]], "Input",
 CellChangeTimes->{{3.937243495777293*^9, 3.9372435015940228`*^9}},
 CellLabel->"In[25]:=",ExpressionUUID->"675dda5f-8cf2-457b-8f0f-06c6f10c8ac0"],

Cell["\<\
Here\[CloseCurlyQuote]s an experiment: what if we standardized the data by \
sort order to avoid different points being too close to each other.\
\>", "Text",
 CellChangeTimes->{{3.9381730771763372`*^9, 3.9381731121267147`*^9}, 
   3.938177591328414*^9},ExpressionUUID->"53d85d75-b89a-4397-b389-\
bfdcc60e8db7"],

Cell[BoxData[
 RowBox[{
  RowBox[{"DiscreteLevels", " ", "=", " ", 
   RowBox[{"2", "*", 
    RowBox[{"Flatten", "[", 
     RowBox[{
      RowBox[{"Values", "@", " ", 
       RowBox[{"KeySort", "@", 
        RowBox[{"PositionIndex", "[", 
         RowBox[{
          RowBox[{"Sort", "[", 
           RowBox[{"MapIndexed", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"{", 
               RowBox[{"#1", ",", 
                RowBox[{"#2", "[", 
                 RowBox[{"[", "1", "]"}], "]"}]}], "}"}], "&"}], ",", 
             "SuggestedLevels"}], "]"}], "]"}], "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", "2"}], "]"}], "]"}], "]"}]}]}], ",", "1"}], 
     "]"}]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.938173114024168*^9, 3.938173261560273*^9}, {
  3.9382665115552597`*^9, 3.938266511988018*^9}, {3.9382665501933117`*^9, 
  3.938266550297798*^9}},
 CellLabel->"In[26]:=",ExpressionUUID->"7a725edf-62e0-48cb-b78c-2c3171759e45"],

Cell[BoxData[
 RowBox[{"ListPlot", "[", "DiscreteLevels", "]"}]], "Input",
 CellChangeTimes->{{3.9382611368653307`*^9, 3.938261143602027*^9}},
 CellLabel->"In[27]:=",ExpressionUUID->"bb71b864-93ad-47be-b30e-c27d9f75a268"],

Cell["\<\
Now we need to construct new geometry according to the Levels embedding. We\
\[CloseCurlyQuote]ll need the ArcLines associated to the diagram. The \
strategy is to add a vertical segment to the curve at the first corner (or \
failing that, in the middle of the arc) which connects the levels at the \
start and end of the arc. So ArcLine[i] should be the line corresponding to \
edge i in the PD code (assuming that we\[CloseCurlyQuote]ve run \
CompressDiagramInPlace recently):\
\>", "Text",
 CellChangeTimes->{{3.9380938537113028`*^9, 3.938093884237088*^9}, {
  3.9381603669296207`*^9, 3.938160401590376*^9}, {3.938160478163927*^9, 
  3.93816060612957*^9}, {3.938162830920148*^9, 3.9381628310996943`*^9}, {
  3.938163170397683*^9, 3.938163237359633*^9}, {3.938165725586954*^9, 
  3.9381657613475857`*^9}, {3.938165813953108*^9, 3.93816581467209*^9}, {
  3.9382649127939053`*^9, 3.938264930059504*^9}, {3.938264961424674*^9, 
  3.938264961994701*^9}},ExpressionUUID->"2b843a95-8498-476c-a6ac-\
485be8ec550c"],

Cell["\<\
The value L[[i+1]] is the height of edge i at it\[CloseCurlyQuote]s outgoing \
crossing. L[[i+2]] is the height at the incoming crossing. We\
\[CloseCurlyQuote]ll make a new association which assigns this pair to each \
edge index.\
\>", "Text",
 CellChangeTimes->{{3.9372415898611393`*^9, 3.937241657075429*^9}, {
   3.9372418203203287`*^9, 3.937241823989394*^9}, {3.938165839271955*^9, 
   3.9381659472866507`*^9}, 3.9381659794962463`*^9, {3.938265277567279*^9, 
   3.938265359119864*^9}},ExpressionUUID->"05b894ba-24e1-4375-915c-\
7b3450420bbe"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ProcessArcLine", "[", "a_", "]"}], " ", ":=", " ", 
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"Length", "[", "a", "]"}], "==", "2"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"a", "[", 
       RowBox[{"[", "1", "]"}], "]"}], ",", 
      RowBox[{"Mean", "[", "a", "]"}], ",", 
      RowBox[{"Mean", "[", "a", "]"}], ",", 
      RowBox[{"a", "[", 
       RowBox[{"[", "2", "]"}], "]"}]}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"Join", "[", 
     RowBox[{
      RowBox[{"a", "[", 
       RowBox[{"[", 
        RowBox[{"1", ";;", "2"}], "]"}], "]"}], ",", 
      RowBox[{"a", "[", 
       RowBox[{"[", 
        RowBox[{"2", ";;"}], "]"}], "]"}]}], "]"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.938265916968359*^9, 3.9382659535254583`*^9}, {
  3.938266203318939*^9, 3.938266213293292*^9}},
 CellLabel->"In[28]:=",ExpressionUUID->"6128bee0-ae79-4317-9510-ee777c58658b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"LevelsEmbedding", "[", 
   RowBox[{"PD_", ",", "L_"}], "]"}], ":=", " ", 
  RowBox[{"Block", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"augmentedArcLines", ",", "al", ",", "procL", ",", 
      RowBox[{"Lm", "=", "2"}], ",", "almost", ",", "edgeHeights"}], "}"}], 
    ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"edgeHeights", " ", "=", " ", 
      RowBox[{"Association", "@", 
       RowBox[{"MapIndexed", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"First", "[", "#2", "]"}], "-", "1"}], "->", "#1"}], 
          "&"}], ",", 
         RowBox[{"Transpose", "[", 
          RowBox[{"{", 
           RowBox[{"L", ",", 
            RowBox[{"RotateLeft", "[", "L", "]"}]}], "}"}], "]"}]}], 
        "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"al", " ", "=", 
      RowBox[{"ProcessArcLine", " ", "/@", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"Round", "[", 
           RowBox[{"#", ",", "10"}], "]"}], "&"}], "/@", 
         RowBox[{"ArcLines", "@", 
          RowBox[{"Spherogram", "@", "PD"}]}]}], ")"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
