#!/bin/sh
#
# Knoodle pre-push: Git LFS first, then the push policy.
#
# THE LFS PART IS NOT OPTIONAL AND MUST COME FIRST. Setting core.hooksPath
# disables the hooks git-lfs installed into .git/hooks, so this file has to do
# their job as well as ours. Getting that wrong breaks LFS pushes silently --
# objects simply do not upload -- which is why the block below is a verbatim
# copy of what `git lfs install` writes.
#
# STDIN IS THE SUBTLE PART. A pre-push hook receives one line per ref on
# stdin:
#
#     <local ref> <local sha> <remote ref> <remote sha>
#
# `git lfs pre-push` READS that stream. If it ran first in a pipeline the
# policy below would find stdin empty and think nothing was being pushed --
# it would pass, every time, silently. So stdin is captured once here and
# replayed to both.

# --- Git LFS (verbatim from `git lfs install`) ------------------------------
command -v git-lfs >/dev/null 2>&1 || {
    printf >&2 "\n%s\n\n" "This repository is configured for Git LFS but 'git-lfs' was not found on your path. If you no longer wish to use Git LFS, remove this hook by deleting the 'pre-push' file in the hooks directory (set by 'core.hookspath'; usually '.git/hooks')."
    exit 2
}

# Capture the ref list once; both consumers get their own copy.
REFS=$(cat)

printf '%s\n' "$REFS" | git lfs pre-push "$@" || exit $?

# --- Knoodle push policy ----------------------------------------------------
HOOK_DIR=$(dirname "$0")
printf '%s\n' "$REFS" | "$HOOK_DIR/knoodle-push-policy" "$@"
