#!/bin/sh
#
# The push policy. Invoked by pre-push with the ref list on stdin.
#
#   local commit, any branch   nothing runs. Commits are free, and main is
#                              allowed to carry WIP history.
#   push to a branch           light tier runs. Red is a WARNING and the push
#                              proceeds -- that is what WIP is for -- but a
#                              commit of ours must SAY so.
#   push to main               light tier runs. Red REFUSES. Everybody,
#                              including Henrik, has to override deliberately.
#   push a v* tag              the heavy-tier stamp for that commit is
#                              required. Refuses without it.
#
# Override: KNOODLE_PUSH_RED=1. Deliberately NOT --no-verify, which would also
# skip the Git LFS hook above and corrupt the push.

set -u

REPO=$(git rev-parse --show-toplevel)
TEST_DIR="$REPO/test"
STAMPS="$TEST_DIR/.stamps"
OVERRIDE="${KNOODLE_PUSH_RED:-}"
ZERO="0000000000000000000000000000000000000000"

# What kinds of push is this? A single `git push` can carry several refs.
pushing_main=0
pushing_tag=""
pushing_branch=""
tag_sha=""
main_sha=""

while read -r local_ref local_sha remote_ref remote_sha; do
    [ -z "${remote_ref:-}" ] && continue
    [ "${local_sha:-}" = "$ZERO" ] && continue          # deleting a ref
    case "$remote_ref" in
        refs/heads/main)  pushing_main=1; main_sha="$local_sha" ;;
        refs/tags/v*)     pushing_tag="$remote_ref"
                          # Releases are ANNOTATED tags, and for those git hands
                          # us the tag object's sha. The stamp is keyed on the
                          # commit, so look through the tag to the commit it names.
                          tag_sha=$(git rev-parse --verify --quiet "$local_sha^{commit}" 2>/dev/null) \
                              || tag_sha="$local_sha" ;;
        refs/heads/*)     pushing_branch="${remote_ref#refs/heads/}" ;;
    esac
done

[ "$pushing_main" = 0 ] && [ -z "$pushing_tag" ] && [ -z "$pushing_branch" ] && exit 0

# --- the release gate -------------------------------------------------------
if [ -n "$pushing_tag" ]; then
    version="${pushing_tag#refs/tags/}"
    if [ -f "$STAMPS/heavy-$tag_sha" ]; then
        printf '\npre-push: heavy tier verified for %s at %s\n\n' "$version" "$(echo "$tag_sha" | cut -c1-12)"
    elif [ -n "$OVERRIDE" ]; then
        printf '\npre-push: KNOODLE_PUSH_RED set -- releasing %s without a heavy-tier run.\n\n' "$version"
    else
        cat >&2 <<EOF

Refusing to push the version tag $version.

The heavy tier has not been run cleanly at this commit ($(echo "$tag_sha" | cut -c1-12)).
A tag is where a release starts, so this is the last point at which a corner-case
regression can be caught before users see it.

  To run it (about fifteen minutes, with the build):
      make -C test check-full

  To tag anyway, without having run it:
      KNOODLE_PUSH_RED=1 git push ${1:-origin} $version

EOF
        exit 1
    fi
fi

[ "$pushing_main" = 0 ] && [ -z "$pushing_branch" ] && exit 0

# --- the light tier ---------------------------------------------------------
head_sha=$(git rev-parse HEAD)
dirty=$(git status --porcelain --untracked-files=no)

# Where the run is kept. run_tier.py writes each test's full output to
# logs/light/<target>.log and the names of the tests that did not pass to
# logs/light/failed.txt; this hook keeps the whole `make check` transcript next
# to them as logs/pre-push.log. Nothing is deleted: when a push goes red, the
# full story is still on disk afterwards. (KNOODLE_PUSH_LOG_DIR is a test seam
# for hooks_check, which must not touch the real logs.)
LOG_DIR="${KNOODLE_PUSH_LOG_DIR:-$TEST_DIR/logs}"
FAILED_FILE="$LOG_DIR/light/failed.txt"
SHOW_LOG_DIR=$(echo "$LOG_DIR" | sed "s|^$REPO/||")

# Test seam: test/hooks_check sets KNOODLE_PUSH_TIER_RESULT to exercise the
# red paths without waiting 15s for a real run, and without needing a way to
# make a passing suite fail. Unset in normal use, which is the only way the
# tier actually runs.
if [ -n "${KNOODLE_PUSH_TIER_RESULT:-}" ]; then
    tier_rc="$KNOODLE_PUSH_TIER_RESULT"
elif [ -z "$dirty" ] && [ -f "$STAMPS/light-$head_sha" ]; then
    printf '\npre-push: light tier already verified at %s\n' "$(echo "$head_sha" | cut -c1-12)"
    tier_rc=0
else
    printf '\npre-push: running the light tier (~15s of runs; a header bump adds a parallel rebuild)...\n\n'
    mkdir -p "$LOG_DIR"
    # A failed.txt from an earlier run must not be read as this run's: if the
    # build fails, run_tier.py never runs and never writes a new one.
    rm -f "$FAILED_FILE"
    ( cd "$TEST_DIR" && make --no-print-directory check >"$LOG_DIR/pre-push.log" 2>&1 )
    tier_rc=$?
    if [ "$tier_rc" != 0 ]; then
        tail -40 "$LOG_DIR/pre-push.log" >&2
        printf '\n(whole run: %s/pre-push.log; each test'"'"'s own output: %s/light/)\n' \
            "$SHOW_LOG_DIR" "$SHOW_LOG_DIR" >&2
    else
        tail -4 "$LOG_DIR/pre-push.log"
    fi
fi

if [ "$tier_rc" = 0 ]; then
    exit 0
fi

# The names come from the run that just happened -- never from a second run,
# which would cost another 15s and could disagree with the first.
if [ -n "${KNOODLE_PUSH_TIER_FAILED:-}" ]; then
    failed="$KNOODLE_PUSH_TIER_FAILED"
elif [ -s "$FAILED_FILE" ]; then
    failed=$(tr '\n' ' ' < "$FAILED_FILE" | sed 's/ *$//')
elif [ -f "$FAILED_FILE" ]; then
    failed="(none by name -- see $SHOW_LOG_DIR/pre-push.log)"
else
    failed="(the build or lint failed before any test ran -- see $SHOW_LOG_DIR/pre-push.log)"
fi

# --- red, pushing to main ---------------------------------------------------
if [ "$pushing_main" = 1 ]; then
    if [ -n "$OVERRIDE" ]; then
        printf '\npre-push: KNOODLE_PUSH_RED set -- pushing red tests to main.\n\n' >&2
        exit 0
    fi
    cat >&2 <<EOF

Tests failed: $failed

Pushing red tests to main is blocked. Recommend investigating before pushing to
main, or pushing this commit to a branch instead.

  To push to main anyway:
      KNOODLE_PUSH_RED=1 git push origin main

  To put it on a branch instead:
      git push origin HEAD:refs/heads/<branch-name>

EOF
    exit 1
fi

# --- red, pushing to a branch: allowed, but it has to say so ----------------
# Red on a branch is legitimate -- that is what WIP is for. The only
# requirement is that the history says so honestly. "Ours" is detected by the
# mandatory credit line, so this binds our commits and not hand-written ones.
range_start=$(git rev-parse "origin/$pushing_branch" 2>/dev/null)
if [ -n "$range_start" ]; then
    range="$range_start..HEAD"
else
    range="origin/main..HEAD"
fi

ours=$(git log --format='%H' --grep='Prepared with Claude Code' "$range" 2>/dev/null | head -1)
wip=$(git log -1 --format='%B' 2>/dev/null | grep -ciE 'WIP|does not pass testing')

if [ -n "$ours" ] && [ "$wip" = 0 ] && [ -z "$OVERRIDE" ]; then
    cat >&2 <<EOF

Tests failed: $failed

Pushing red tests to a branch is fine -- that is what WIP is for -- but the
commit message has to say so, and this one does not.

  To fix the message and push:
      git commit --amend
      (add a line such as: "WIP: pushes red, $failed failing")
      git push ${1:-origin}

  To push as-is:
      KNOODLE_PUSH_RED=1 git push ${1:-origin}

EOF
    exit 1
fi

cat >&2 <<EOF

WARNING: tests failed: $failed

Pushing to a branch anyway. Investigate before this reaches main.

EOF
exit 0
